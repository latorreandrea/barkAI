# Build context uploaded to Cloud Storage by `gcloud builds submit` (not used by
# the GitHub -> Cloud Build triggers). Without this file gcloud would fall back to
# .gitignore, which is written for git rather than for an upload: here the list is
# explicit and .env comes first, because a secret uploaded to a bucket is an
# incident rather than an inconvenience.

# --- Secrets and local state ---
.env
db.sqlite3
db.sqlite3-journal

# --- Version control and CI ---
.git
.github

# --- Local toolchain ---
.venv
node_modules
package-lock.json
staticfiles

# --- Python noise ---
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# --- Editor / OS ---
.vscode
.idea
.DS_Store

